            <pentabarf:title>Open OnDemand Project Update</pentabarf:title>
            <pentabarf:subtitle></pentabarf:subtitle>
            <pentabarf:language>en</pentabarf:language>
            <pentabarf:language-code>en</pentabarf:language-code>
            <dtstart>20260311T090000</dtstart>
            <dtend>20260311T092500</dtend>
            <duration>002500</duration>
            <summary>Open OnDemand Project Update</summary>
            <description></description>
            <class>PUBLIC</class>
            <status>CONFIRMED</status>
            <category>Talk</category>
            <url>https://pretalx.com/good-2026/talk/PAHRWR/</url>
